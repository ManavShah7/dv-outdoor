# Copy to .env.local for development. Every one of these also has to exist as
# a Vercel environment variable, or the deploy builds and then fails at runtime.

# The origin the QR codes on the boards encode. Getting this wrong means every
# printed QR points somewhere that does not exist.
NEXT_PUBLIC_SITE_URL=https://timesmedia.online

# Supabase. The service-role key bypasses RLS — server-side only, never expose.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# The admin assistant. /api/chat is admin-gated, but this still bills per call.
ANTHROPIC_API_KEY=
# Only needed if the key above is org-level (unscoped).
# ANTHROPIC_WORKSPACE_ID=

# Restrict this key to the deployed domain in the Google Cloud console
# (HTTP referrers) or anyone can spend against it.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Field-agent invites by WhatsApp. Unset means invites are link-only.
WHATSAPP_PROVIDER=
WHATSAPP_API_KEY=
WHATSAPP_FROM_NUMBER=
